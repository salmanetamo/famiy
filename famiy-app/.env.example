# Local-only dev account used for manual and (later) Playwright checks against the real API.
# Copy to .env.local (gitignored) and choose your own password (12 to 128 characters).
E2E_EMAIL=dev@famiy.local
E2E_PASSWORD=

# The Playwright smoke test (npm run e2e) keeps its own account here after its first run.
# Leave these unset: the first run registers an account and fills them in .env.local.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
