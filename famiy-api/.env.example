# Copy to .env (git-ignored). Values below are local-dev only; never reuse in production.
# Host port is 5433 because a local Postgres service may already own 5432 on Windows.
# Keep values unquoted: the Makefile includes this file.
POSTGRES_USER=famiy
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=famiy
POSTGRES_PORT=5433

HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://famiy:change-me-locally@localhost:5433/famiy?sslmode=disable

# Accounts and sessions (ADR-004). In code the safe defaults are: registration
# CLOSED, cookies Secure. This file opens registration for local development.
REGISTRATION_ENABLED=true
MAX_USERS=10
SESSION_TTL=720h
# Most people one account may create (bounds the GET /graph response; ~3 MB of JSON at 10000).
MAX_PERSONS_PER_ACCOUNT=10000
# Plain-HTTP localhost needs COOKIE_SECURE=false; always leave it true behind HTTPS.
COOKIE_SECURE=false
# Comma-separated extra browser origins allowed to make state-changing requests
# (e.g. the Vite dev server). Same-origin requests need no entry.
ALLOWED_ORIGINS=
# CIDRs of the reverse proxy in front of this server (Caddy). REQUIRED behind a proxy:
# the login limiter keys on the client address, and without this every client looks
# like the proxy, so one client's failed logins can lock everyone out. With Docker
# the proxy usually reaches the container from the bridge network, e.g. 172.16.0.0/12;
# check the "request" log lines or the peer address before relying on it.
# The server logs a warning at startup when this is empty and COOKIE_SECURE=true.
TRUSTED_PROXIES=
